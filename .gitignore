# dependencies
node_modules/
.pnp
.pnp.js

# build
.next/
out/
dist/
build/
storybook-static/
*.tsbuildinfo

# env files (actual configs with secrets — never commit)
.env
.env.local
.env.mock
.env.dev
.env.demo
.env.uat
.env.prod
.env.development.local
.env.test.local
.env.production.local
# .env.example is tracked (template only, no secrets)

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
.claude/

# next.js
next-env.d.ts

# data (runtime generated)
apps/web/data/learning/*.jsonl
apps/web/data/.locks/
apps/web/data/audit/

# Engine runtime data — sessions, logs, learning aggregates, watch state,
# preferences. Regenerated by the engine; checking them in just produces
# noisy diffs and accidental commits of dev session contents.
apps/engine/data/learning/**/*.jsonl
apps/engine/data/learning/**/signal-aggregates.json
apps/engine/data/learning/**/synonyms.json
apps/engine/data/sessions/
apps/engine/data/logs/
apps/engine/data/audit/audit.jsonl
# Rotated audit / interaction / conversation files produced by the
# rotating-jsonl helper at the 10MB threshold (audit.<ts>.jsonl,
# interactions.<ts>.jsonl, conversations.<ts>.jsonl, etc).
apps/engine/data/**/*.[0-9]*.jsonl
apps/engine/data/preferences/*.json
apps/engine/data/anomaly/**/history.jsonl
apps/engine/data/anomaly/**/snapshots.jsonl
apps/engine/data/anomaly/**/baselines.json
apps/engine/data/anomaly/**/seasonal-baselines.json
apps/engine/data/watch/**/alerts.jsonl
# Watch rule volatile state (lastCheckedAt/lastTriggeredAt) — split out of
# rules.json so committed rule definitions don't churn on every cron tick.
apps/engine/data/watch/**/rules-state.json
# Schema-drift baselines — regenerated on first query against each (group, query)
apps/engine/data/schema/
# Search indexes — derived embeddings, rebuilt on init
apps/engine/data/indexes/**/semantic-index.json
# Shareable view snapshots — runtime user-generated state
apps/engine/data/views/
# Data Explorer saved dashboards — per-user/group runtime state (file-based DB)
apps/engine/data/data-explorer-views/

# tool artifacts (per-user, not project)
.playwright-mcp/
.superpowers/
graphify-out/
.gstack/
