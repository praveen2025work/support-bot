# dependencies
node_modules/
.pnp
.pnp.js

# build
.next/
out/
dist/
build/
storybook-static/
*.tsbuildinfo

# env files (actual configs with secrets — never commit)
.env
.env.local
.env.mock
.env.dev
.env.prod
.env.development.local
.env.test.local
.env.production.local
# .env.example is tracked (template only, no secrets)

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
*.pem
.claude/

# next.js
next-env.d.ts

# data (runtime generated)
data/learning/*.jsonl
data/.locks/
data/audit/

# Engine runtime data — sessions, logs, learning aggregates, watch state,
# preferences. Regenerated by the engine; checking them in just produces
# noisy diffs and accidental commits of dev session contents.
services/engine/data/learning/**/*.jsonl
services/engine/data/learning/**/signal-aggregates.json
services/engine/data/sessions/
services/engine/data/logs/
services/engine/data/audit/audit.jsonl
services/engine/data/preferences/*.json
services/engine/data/anomaly/**/history.jsonl
services/engine/data/anomaly/**/snapshots.jsonl
services/engine/data/watch/**/alerts.jsonl

# tool artifacts (per-user, not project)
.playwright-mcp/
.superpowers/
