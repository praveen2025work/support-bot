          "debit",
          "credit",
          "net_pnl",
          "break_count",
          "unreconciled_amount",
          "aging_days"
        ]
      },
      "drillDown": [
        {
          "sourceColumn": "business_unit",
          "targetQuery": "budget_vs_actual",
