{
  "queries": [
    {
      "id": "q68",
      "name": "budget_vs_actual",
      "description": "Budget vs Actual comparison by cost center — identifies over/under spending with variance analysis",
      "estimatedDuration": 2200,
      "url": "",
      "source": "finance",
      "filters": [
        {
          "key": "fiscal_year",
          "binding": "body"
        },
        {
          "key": "cost_center",
          "binding": "body"
        }
      ],
      "type": "api",
      "endpoint": "/finance/pnl/budget-vs-actual",
      "authType": "none",
      "chartConfig": {
        "defaultType": "bar",
        "labelKey": "cost_center",
        "valueKeys": ["budget", "actual"],
        "showLegend": true
      },
      "columnConfig": {
        "labelColumns": ["cost_center", "category"],
        "valueColumns": [
          "budget",
          "actual",
          "variance",
          "variance_pct",
          "status"
        ]
      }
    },
