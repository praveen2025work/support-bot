    {
      "id": "q98",
      "name": "pnl_subledger",
      "description": "Bank P&L sub-ledger balances, postings, breaks, unreconciled exposure, aging, and sign-off status by business unit, desk, product, and region",
      "estimatedDuration": 1800,
      "url": "https://confluence.example.com/wiki/finance/bank-pnl-subledger",
      "source": "finance",
      "filters": [
        {
          "key": "date_range",
          "binding": "body"
        },
        {
          "key": "business_unit",
          "binding": "body"
        },
        {
          "key": "region",
          "binding": "body"
        },
        {
          "key": "status",
          "binding": "body"
        }
      ],
      "type": "api",
      "endpoint": "/finance/pnl/subledger",
      "method": "POST",
      "authType": "none",
      "chartConfig": {
        "defaultType": "bar",
        "labelKey": "sub_ledger",
        "valueKeys": ["net_pnl", "unreconciled_amount", "break_count"],
        "showLegend": true
      },
      "columnConfig": {
        "idColumns": ["sub_ledger"],
        "dateColumns": ["business_date"],
        "labelColumns": [
