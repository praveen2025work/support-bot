{
  "openapi": "3.0.3",
  "info": {
    "title": "Chatbot Engine — Admin API",
    "version": "1.0.0",
    "description": "Per-group operator surface for the Chatbot Engine. All admin endpoints sit behind the x-user-role / RBAC layer (see services/engine/src/lib/rbac.ts). Chat-side endpoints and read-only ops (metrics, health, view snapshot read) are public. Error responses follow the canonical envelope { error, code, requestId, retryable?, details? }.",
    "contact": {
      "name": "Engine team",
      "url": "https://github.com/praveen2025work/support-bot"
    }
  },
  "servers": [
    { "url": "http://localhost:4001", "description": "Local dev" },
    { "url": "/", "description": "Same-origin (via Next.js proxy)" }
  ],
  "tags": [
    { "name": "Health", "description": "Liveness, readiness, source health" },
    { "name": "Chat", "description": "User-facing chat surface" },
    { "name": "Snapshots", "description": "Shareable view snapshots" },
    { "name": "Observability", "description": "Prometheus metrics" },
    { "name": "Admin · Synonyms", "description": "Per-group vocabulary" },
    { "name": "Admin · Learning", "description": "Review queue + retrain" },
    { "name": "Admin · Schema", "description": "Drift detection + ack" },
    { "name": "Admin · Sources", "description": "Data-source health" },
    { "name": "Admin · Analytics", "description": "NLP-miss aggregates" },
    {
      "name": "Admin · Catalog",
      "description": "Intents, entities, templates, settings"
    }
  ],
  "components": {
    "securitySchemes": {
      "userRole": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-role",
        "description": "One of: admin, builder, viewer. Sets req.userRole used by requirePermission middleware."
      },
      "engineApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-engine-api-key",
        "description": "Optional production gate (set ENGINE_API_KEY)."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error", "code"],
        "properties": {
          "error": { "type": "string", "example": "Invalid message format" },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_MESSAGE",
              "INVALID_FORCE_INTENT",
              "ENGINE_NOT_READY",
              "DATA_SOURCE_UNAVAILABLE",
              "QUERY_NOT_FOUND",
              "RATE_LIMITED",
              "AUTHENTICATION_REQUIRED",
              "INSUFFICIENT_PERMISSIONS",
              "NOT_FOUND",
              "REQUEST_TOO_LARGE",
              "INTERNAL_ERROR"
            ]
          },
          "requestId": { "type": "string", "format": "uuid" },
          "retryable": { "type": "boolean" },
          "details": { "type": "object", "additionalProperties": true }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": ["text", "sessionId"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sessionId": { "type": "string", "minLength": 1 },
          "groupId": { "type": "string", "default": "default" },
          "platform": {
            "type": "string",
            "enum": ["web", "widget", "teams"],
            "default": "web"
          },
          "explicitFilters": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "Filter form bypass — when provided (even as empty object), skips the filter UI."
          },
          "forceIntent": {
            "type": "string",
            "description": "Bypass NLP and execute the named query. Used by the chip-click disambiguation flow. Engine validates against the user's group catalog."
          },
          "followUpChain": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Chain of follow-up texts processed server-side. Each is applied to the previous response's context."
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "richContent": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "csv_table",
                  "csv_aggregation",
                  "csv_group_by",
                  "csv_summary",
                  "knowledge_search",
                  "query_filter_form",
                  "forecast_result",
                  "trend_analysis",
                  "anomaly_table"
                ]
              },
              "data": { "type": "object" }
            }
          },
          "intent": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sessionId": { "type": "string" }
        }
      },
      "SynonymEntry": {
        "type": "object",
        "required": ["canonical", "synonyms", "updatedAt"],
        "properties": {
          "canonical": { "type": "string", "example": "customer" },
          "synonyms": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["client", "account", "buyer"]
          },
          "updatedAt": { "type": "string", "format": "date-time" },
          "updatedBy": { "type": "string" }
        }
      },
      "SourceHealth": {
        "type": "object",
        "required": [
          "baseUrl",
          "status",
          "lastChecked",
          "consecutiveFails",
          "flips"
        ],
        "properties": {
          "baseUrl": { "type": "string", "format": "uri" },
          "status": {
            "type": "string",
            "enum": ["ok", "unreachable", "unknown"]
          },
          "lastChecked": { "type": "string", "format": "date-time" },
          "latencyMs": { "type": "integer" },
          "lastError": { "type": "string" },
          "consecutiveFails": { "type": "integer" },
          "flips": { "type": "integer" }
        }
      },
      "SchemaDriftEntry": {
        "type": "object",
        "properties": {
          "groupId": { "type": "string" },
          "queryName": { "type": "string" },
          "observedAt": { "type": "string", "format": "date-time" },
          "driftFlaggedAt": { "type": "string", "format": "date-time" },
          "drift": {
            "type": "object",
            "properties": {
              "added": { "type": "array", "items": { "type": "string" } },
              "removed": { "type": "array", "items": { "type": "string" } },
              "reorderedFrom": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "ViewSnapshot": {
        "type": "object",
        "required": ["id", "createdAt", "groupId", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 6 },
          "createdAt": { "type": "string", "format": "date-time" },
          "createdBy": { "type": "string" },
          "groupId": { "type": "string" },
          "queryName": { "type": "string" },
          "text": { "type": "string" },
          "richContent": { "type": "object" },
          "intent": { "type": "string" },
          "confidence": { "type": "number" }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Liveness probe",
        "description": "Cheap, always-200 if the process is alive. Reports uptime + memory.",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "uptime": { "type": "number" },
                    "memory": {
                      "type": "object",
                      "properties": {
                        "heapUsedMB": { "type": "integer" },
                        "rssMB": { "type": "integer" }
                      }
                    },
                    "engines": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "tags": ["Health"],
        "summary": "Readiness probe",
        "description": "Returns 503 when NLP is not initialized, the data directory is unreachable, or every configured data source is down. Load balancers should drain on 503.",
        "responses": {
          "200": {
            "description": "Ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["ready"] },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "nlp": { "type": "boolean" },
                        "dataDir": { "type": "boolean" },
                        "sources": { "type": "boolean" }
                      }
                    },
                    "sources": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "ok": { "type": "integer" },
                        "unreachable": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Not ready — at least one essential subsystem is down",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": ["Observability"],
        "summary": "Prometheus scrape",
        "description": "Text-exposition format. Public — scrapers don't auth. Emits chat_requests_total, chat_request_duration_seconds (summary), engines_initialized, sources_ok / sources_unreachable, plus process_* gauges.",
        "responses": {
          "200": {
            "description": "Prometheus text body",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": ["Chat"],
        "summary": "Send a chat message",
        "description": "The user-facing entrypoint. The engine routes through NLP classification → follow-up dispatch (group_by, drill_down, sort, summary, etc.) → query execution → response generation. Returns the structured envelope on errors.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatMessage" }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "x-user-role",
            "schema": {
              "type": "string",
              "enum": ["admin", "builder", "viewer"]
            },
            "description": "Drives PII clear-text view permission. Default = viewer (PII masked)."
          }
        ],
        "responses": {
          "200": {
            "description": "Chat response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid message format",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "413": {
            "description": "Request body exceeds limit",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "429": {
            "description": "Rate limited (chatLimiter)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "503": {
            "description": "Data source unavailable / chat timeout",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/views/snapshot": {
      "post": {
        "tags": ["Snapshots"],
        "summary": "Create a shareable snapshot of a chat result",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sessionId", "groupId", "message"],
                "properties": {
                  "sessionId": { "type": "string" },
                  "groupId": { "type": "string" },
                  "userId": { "type": "string" },
                  "queryName": { "type": "string" },
                  "message": {
                    "type": "object",
                    "required": ["text"],
                    "properties": {
                      "text": { "type": "string" },
                      "richContent": { "type": "object" },
                      "intent": { "type": "string" },
                      "confidence": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Snapshot created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "url": { "type": "string", "example": "/share/kJF5Rv9a" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/views/{id}": {
      "get": {
        "tags": ["Snapshots"],
        "summary": "Fetch a snapshot by id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9_-]{6,16}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ViewSnapshot" }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/api/admin/groups/{groupId}/synonyms": {
      "parameters": [
        {
          "in": "path",
          "name": "groupId",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Admin · Synonyms"],
        "summary": "List per-group synonyms",
        "security": [{ "userRole": [] }],
        "responses": {
          "200": {
            "description": "Synonym list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groupId": { "type": "string" },
                    "synonyms": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/SynonymEntry" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Admin · Synonyms"],
        "summary": "Create or update a synonym entry",
        "security": [{ "userRole": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["canonical", "synonyms"],
                "properties": {
                  "canonical": { "type": "string" },
                  "synonyms": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upserted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "entry": { "$ref": "#/components/schemas/SynonymEntry" }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Admin · Synonyms"],
        "summary": "Delete a synonym entry",
        "security": [{ "userRole": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "canonical",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    },
    "/api/admin/learning/review": {
      "get": {
        "tags": ["Admin · Learning"],
        "summary": "List review queue items (low-confidence interactions)",
        "security": [{ "userRole": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "groupId",
            "schema": { "type": "string", "default": "default" }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": ["pending", "resolved", "dismissed"]
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer", "default": 50 }
          }
        ],
        "responses": { "200": { "description": "Review items" } }
      }
    },
    "/api/admin/learning/review/{id}/resolve": {
      "post": {
        "tags": ["Admin · Learning"],
        "summary": "Approve a review item with the correct intent",
        "description": "Appends the utterance to auto-learned.jsonl with source=admin_review. Next /retrain merges into the live NLP corpus.",
        "security": [{ "userRole": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["correctIntent"],
                "properties": {
                  "correctIntent": { "type": "string" },
                  "groupId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Resolved" } }
      }
    },
    "/api/admin/learning/retrain": {
      "post": {
        "tags": ["Admin · Learning"],
        "summary": "Invalidate the engine cache so the next chat re-trains",
        "description": "Async per-group invalidation; concurrent calls coalesce. The actual NLP re-train fires lazily on the next chat request, which reads corpus.json + corpus-<group>.json AND merges every approved auto-learned utterance.",
        "security": [{ "userRole": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "groupId": {
                    "type": "string",
                    "description": "'all' clears every group"
                  }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Retrain triggered" } }
      }
    },
    "/api/admin/schema/drift": {
      "get": {
        "tags": ["Admin · Schema"],
        "summary": "List queries with unacknowledged schema drift",
        "security": [{ "userRole": [] }],
        "parameters": [
          { "in": "query", "name": "groupId", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Flagged queries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": { "type": "integer" },
                    "flagged": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SchemaDriftEntry"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/schema/acknowledge": {
      "post": {
        "tags": ["Admin · Schema"],
        "summary": "Acknowledge drift on a (group, query) pair",
        "description": "Drops the drift flag, keeps the new schema as the baseline, and evicts any cached query results for that (group, query) tuple.",
        "security": [{ "userRole": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["groupId", "queryName"],
                "properties": {
                  "groupId": { "type": "string" },
                  "queryName": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Acknowledged + cache evicted" }
        }
      }
    },
    "/api/admin/sources/health": {
      "get": {
        "tags": ["Admin · Sources"],
        "summary": "Per-baseUrl reachability snapshot",
        "security": [{ "userRole": [] }],
        "responses": {
          "200": {
            "description": "Map of source statuses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "ok": { "type": "integer" },
                    "unreachable": { "type": "integer" },
                    "sources": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/SourceHealth" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/sources/recheck": {
      "post": {
        "tags": ["Admin · Sources"],
        "summary": "Force an immediate probe of every registered source",
        "security": [{ "userRole": [] }],
        "responses": { "200": { "description": "Fresh snapshot" } }
      }
    },
    "/api/admin/analytics/nlp-misses": {
      "get": {
        "tags": ["Admin · Analytics"],
        "summary": "Aggregate NLP miss data from interactions.jsonl",
        "description": "Returns total interactions, miss count (intent=None or conf<floor), top missed phrases with samples, confidence distribution, intent distribution, retry rate within 30s windows.",
        "security": [{ "userRole": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "groupId",
            "schema": { "type": "string", "default": "default" }
          },
          {
            "in": "query",
            "name": "since",
            "schema": { "type": "string", "format": "date-time" }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": { "200": { "description": "Aggregates" } }
      }
    },
    "/api/admin/intents": {
      "get": {
        "tags": ["Admin · Catalog"],
        "summary": "List intents + their training utterances",
        "security": [{ "userRole": [] }],
        "responses": { "200": { "description": "Intents" } }
      },
      "post": {
        "tags": ["Admin · Catalog"],
        "summary": "Create or update an intent",
        "security": [{ "userRole": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["intent", "utterances"],
                "properties": {
                  "intent": { "type": "string" },
                  "utterances": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "answers": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Upserted" } }
      },
      "delete": {
        "tags": ["Admin · Catalog"],
        "summary": "Delete an intent",
        "security": [{ "userRole": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "intent",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/admin/templates": {
      "get": {
        "tags": ["Admin · Catalog"],
        "summary": "List response templates (base + per-group)",
        "security": [{ "userRole": [] }],
        "responses": { "200": { "description": "Templates" } }
      },
      "post": {
        "tags": ["Admin · Catalog"],
        "summary": "Create or update a template",
        "security": [{ "userRole": [] }],
        "responses": { "200": { "description": "Upserted" } }
      }
    },
    "/api/admin/settings": {
      "get": {
        "tags": ["Admin · Catalog"],
        "summary": "Read global settings",
        "security": [{ "userRole": [] }],
        "responses": { "200": { "description": "Settings" } }
      },
      "post": {
        "tags": ["Admin · Catalog"],
        "summary": "Update global settings",
        "security": [{ "userRole": [] }],
        "responses": { "200": { "description": "Updated" } }
      }
    },
    "/api/admin/glossary": {
      "get": {
        "tags": ["Admin · Catalog"],
        "summary": "List business glossary entries for a group",
        "security": [{ "userRole": [] }],
        "parameters": [
          { "in": "query", "name": "groupId", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Glossary file" } }
      },
      "post": {
        "tags": ["Admin · Catalog"],
        "summary": "Create or update a glossary entry",
        "security": [{ "userRole": [] }],
        "responses": { "200": { "description": "Upserted" } }
      },
      "delete": {
        "tags": ["Admin · Catalog"],
        "summary": "Delete a glossary entry",
        "security": [{ "userRole": [] }],
        "parameters": [
          { "in": "query", "name": "groupId", "schema": { "type": "string" } },
          { "in": "query", "name": "id", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Deleted" } }
      }
    },
    "/api/queries/search": {
      "get": {
        "tags": ["Catalog"],
        "summary": "Semantic search across query catalog (autocomplete)",
        "description": "Returns ranked matches. When `userName` is supplied, results are personalised by each user's decayed click-through history.",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": { "type": "string" }
          },
          { "in": "query", "name": "groupId", "schema": { "type": "string" } },
          { "in": "query", "name": "userName", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Ranked results array" } }
      }
    },
    "/api/queries/search/pick": {
      "post": {
        "tags": ["Catalog"],
        "summary": "Record that the user accepted an autocomplete suggestion",
        "description": "Click-through telemetry feeds search-ranking personalisation with a 14-day exponential decay. Anonymous picks (no userName) are a no-op.",
        "responses": { "200": { "description": "Recorded acknowledgement" } }
      }
    },
    "/api/data/sources": {
      "get": {
        "tags": ["Data Explorer"],
        "summary": "List CSV/XLSX sources for a group",
        "description": "When `userName` is supplied, sources reorder by per-user view frequency and carry a `recent: true` flag.",
        "parameters": [
          { "in": "query", "name": "groupId", "schema": { "type": "string" } },
          { "in": "query", "name": "userName", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Source list" } }
      }
    },
    "/api/data/sources/view": {
      "post": {
        "tags": ["Data Explorer"],
        "summary": "Record that the user opened a source",
        "responses": { "200": { "description": "Recorded acknowledgement" } }
      }
    },
    "/api/data/query": {
      "post": {
        "tags": ["Data Explorer"],
        "summary": "Run a paginated query against a source",
        "description": "Returns rows + schema. On page 1 of plain (no group-by, no aggregation) responses, attaches an `insights[]` array of auto-findings (💡 top-mover / concentration).",
        "responses": {
          "200": { "description": "Query result with optional insights" }
        }
      }
    },
    "/api/data/quality/{queryName}": {
      "get": {
        "tags": ["Data Explorer"],
        "summary": "Unified data-quality snapshot for a source",
        "description": "Single call rolling duplicates + missing % + schema drift + anomaly count. Each signal is best-effort; one failure doesn't break the others.",
        "parameters": [
          {
            "in": "path",
            "name": "queryName",
            "required": true,
            "schema": { "type": "string" }
          },
          { "in": "query", "name": "groupId", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Quality snapshot" } }
      }
    },
    "/api/data/forecast/{queryName}": {
      "get": {
        "tags": ["Data Explorer"],
        "summary": "Forecast a numeric column (exponential smoothing)",
        "description": "Returns `{forecastable: true, historical, predicted, dateColumn, valueColumn}` when the data supports it, `{forecastable: false, reason}` otherwise.",
        "parameters": [
          {
            "in": "path",
            "name": "queryName",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "in": "query",
            "name": "valueColumn",
            "schema": { "type": "string" }
          },
          {
            "in": "query",
            "name": "periods",
            "schema": { "type": "integer", "default": 5 }
          },
          { "in": "query", "name": "groupId", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Forecast result envelope" } }
      }
    },
    "/api/data/anomalies": {
      "post": {
        "tags": ["Data Explorer"],
        "summary": "Run anomaly detection over the current filtered view",
        "responses": { "200": { "description": "Anomaly array" } }
      }
    }
  }
}
