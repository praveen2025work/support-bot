# ═══════════════════════════════════════════════════════
# Environment Variables Reference
# ═══════════════════════════════════════════════════════
# Copy this file to one of:
#   .env.mock  — local dev with sample data (npm run dev:mock)
#   .env.dev   — real APIs, real auth       (npm run dev)
#   .env.prod  — production deployment      (npm run start:prod)
#
# See Admin → Guides → Config Guide for detailed setup.
# ═══════════════════════════════════════════════════════

# ── Core ──
NODE_ENV=development                    # development | production

# ── Engine Service ──
# The Next.js app always proxies to the engine. The engine must be running.
ENGINE_URL=http://localhost:4001        # Defaults to http://localhost:4001 when not set
ENGINE_PORT=4001                        # Port the engine listens on (default: 4001)

# ── Storage paths (config + runtime data) ──
# All admin config and runtime state live in JSON files on disk. Defaults are
# relative to the engine working dir (services/engine), so single-instance and
# local dev need NOTHING here. For MULTI-INSTANCE deployments, uncomment these
# and point EVERY engine instance at the SAME shared volume (NFS / RWX PVC) so
# they share one source of truth; give each instance a unique INSTANCE_ID.
# Seed the volume once (copy the engine's baked src/config + src/training); the
# engine auto-migrates any legacy db.json on first boot — see
# docs/DEPLOYMENT.md → "Configuration and Shared Storage".
# Query definitions are file-based (DATA_DIR/queries/<group>.json) — there is NO
# DB_JSON_PATH for the engine; db.json is only the mock-api's sample row data.
# CONFIG_DIR=/mnt/nas/chatbot/config            # groups.json, settings.json, users.json, filter-config.json, data-roles.json (default: src/config)
# DATA_DIR=/mnt/nas/chatbot/data                # per-group query files (queries/<group>.json), learning, indexes, audit, logs, sessions (default: data)
# TRAINING_DIR=/mnt/nas/chatbot/training        # NLP corpus/FAQ: corpus.json, groups/corpus-*.json, groups/faq-*.json (default: src/training)
# KNOWLEDGE_DIR=/mnt/nas/chatbot/knowledge      # uploaded documents (default: DATA_DIR/knowledge)
# INSTANCE_ID=engine-pod-1                      # unique id per instance — tracing + file-lock owner (default: engine-<pid>)

# ── User Authentication (passthrough Windows auth) ──
# Full URL of the AD/SSO endpoint that returns the calling user's identity.
# The endpoint must accept the authenticated request and return JSON shaped like:
#   { samAccountName, userName, displayName, emailAddress, employeeId,
#     name, givenName, surname, middleName, distinguishedName, domain }
# When empty, /api/userinfo returns a dev fallback so the UI still renders.
USER_INFO_URL=
# Deployment requirement: IIS/nginx/corporate gateway in front of Node to
# terminate Windows auth (Negotiate/NTLM). Node forwards Authorization,
# Cookie, X-Forwarded-User, X-IIS-User, X-Remote-User, Remote-User, and
# X-User-Principal-Name headers from the incoming request.
#
# Local dev shortcut — sets a synthetic user keyed on this samAccountName,
# bypassing the network call entirely. Useful for testing role flows
# without standing up IIS. Ignored when NODE_ENV=production.
# USER_INFO_DEV_OVERRIDE_SAM=yoursamname

# ── Data API ──
API_BASE_URL=http://localhost:8080/api  # Tenant API base URL. Mock API for local dev
API_TOKEN=                              # Bearer token for authenticating to tenant APIs

# ── Security ──
ENGINE_API_KEY=                         # Secures Engine admin API. Required in production
LOG_ENCRYPTION_KEY=                     # Optional. Enables AES-256-GCM encryption-at-rest for conversation logs. Leave empty to store logs in plaintext.
NEXT_PUBLIC_WIJMO_LICENSE_KEY=          # Optional. Required to remove Wijmo evaluation watermark in production UI builds.

# ── File Queries ──
# FILE_BASE_DIR=                        # Base directory for CSV/XLSX file paths.
                                        # When set, query filePath values resolve against this dir.
                                        # Example: FILE_BASE_DIR=//server/shared/reports
                                        # When not set, paths resolve relative to the engine directory.

# ── SQL Connector Services (optional) ──
# Standalone microservices for database connectivity. Start only what you need.
MSSQL_CONNECTOR_URL=http://localhost:4002   # MSSQL Connector service URL (default port: 4002)
ORACLE_CONNECTOR_URL=http://localhost:4003  # Oracle Connector service URL (default port: 4003)
CSV_XLSX_CONNECTOR_URL=http://localhost:4004 # CSV/XLSX Connector service URL (default port: 4004)
CONNECTOR_API_KEY=                          # Shared API key for connector services (recommended in production)
MSSQL_CONNECTOR_API_KEY=                    # API key for MSSQL Connector auth
ORACLE_CONNECTOR_API_KEY=                   # API key for Oracle Connector auth
CSV_XLSX_CONNECTOR_API_KEY=                 # API key for CSV/XLSX Connector auth
SQL_CREDENTIAL_KEY=                         # Encryption key for storing DB credentials (required for connectors)

# ── CORS ──
UI_ORIGIN=http://localhost:3001         # Allowed CORS origin for Engine

# ── Teams Bot (optional) ──
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
